{
  "name": "anythings-world-agent",
  "version": "1.0.0",
  "description": "Fully autonomous AI-agent pipeline for AnyThings World™ YouTube Shorts channel: sources real, cited facts, writes scripts, produces branded/watermarked video, uploads, and self-optimizes.",
  "main": "dist/orchestrator.js",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "run:once": "node dist/orchestrator.js",
    "dev": "ts-node --esm src/orchestrator.ts",
    "auth:youtube": "node dist/services/youtubeAuthSetup.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "googleapis": "^144.0.0",
    "msedge-tts": "^2.0.7",
    "node-fetch": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  }
}
